rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPlatformAdminEmail() {
      return isEmailVerified() && request.auth.token.email == 'bernardo@awalabs.com';
    }

    function isPlatformAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'bernardo@awalabs.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function clubExists(clubId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId));
    }

    function getClub(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }

    function isClubOwner(clubId) {
      return isEmailVerified() && clubExists(clubId) && getClub(clubId).ownerUid == request.auth.uid;
    }

    function membershipExists(clubId, uid) {
      return exists(/databases/$(database)/documents/clubs/$(clubId)/memberships/$(uid));
    }

    function getMembership(clubId, uid) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/memberships/$(uid)).data;
    }

    function isClubAdmin(clubId) {
      return isEmailVerified() && (
        isPlatformAdmin() ||
        isClubOwner(clubId) ||
        (membershipExists(clubId, request.auth.uid) && getMembership(clubId, request.auth.uid).role == 'admin')
      );
    }

    function isClubStaffOrAdmin(clubId) {
      return isEmailVerified() && (
        isClubAdmin(clubId) ||
        (membershipExists(clubId, request.auth.uid) && getMembership(clubId, request.auth.uid).role in ['admin', 'staff'])
      );
    }

    function isClubMember(clubId) {
      return isEmailVerified() && (
        isClubStaffOrAdmin(clubId) ||
        membershipExists(clubId, request.auth.uid)
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Helpers (No existing() or diff() inside!)
    // -------------------------------------------------------------------------
    function isValidAdminMarker(data, uid) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && data.uid == uid
        && isValidId(data.uid)
        && data.createdAt is timestamp;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'category', 'gender', 'preferredModality', 'weeklyAvailability', 'activeClubIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'category', 'gender', 'preferredModality', 'weeklyAvailability', 'activeClubIds', 'alertPrefs', 'fillCounter', 'createdAt', 'updatedAt'])
        && (!('alertPrefs' in data) || isValidAlertPrefs(data.alertPrefs))
        && data.uid == uid
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.category is int && data.category >= 1 && data.category <= 8
        && data.gender is string && data.gender in ['masculino', 'femenino']
        && data.preferredModality is string && data.preferredModality in ['masculino', 'femenino', 'mixto']
        && data.weeklyAvailability is list && data.weeklyAvailability.size() <= 21
        && data.activeClubIds is list && data.activeClubIds.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // "Falta uno": cuántas invitaciones por semana acepta el jugador y cuánta diferencia de categoría.
    function isValidAlertPrefs(p) {
      return p is map && p.keys().hasOnly(['weeklyInvites', 'maxCategoryGap'])
        && p.weeklyInvites is int && p.weeklyInvites in [0, 3, 6, -1]
        && p.maxCategoryGap is int && p.maxCategoryGap in [0, 1, 2];
    }

    function isValidUserPrivateInfo(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'updatedAt'])
        && data.uid == uid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.updatedAt is timestamp;
    }

    function isValidClub(data, clubId) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'primaryColor', 'accentColor', 'address', 'city',
          'lat', 'lng', 'ownerUid', 'slotDurationMinutes', 'openHour', 'closeHour',
          'basePrice', 'nightFromHour', 'nightPrice', 'weekendPrice',
          'cancellationHours', 'maxNoShowsBeforeBlock', 'mpEnabled', 'mpMode',
          'mpDepositPercent', 'subscriptionStatus', 'monthlyPricePerCourt', 'courtCount',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'primaryColor', 'accentColor', 'address', 'neighborhood', 'city',
          'lat', 'lng', 'ownerUid', 'slotDurationMinutes', 'openHour', 'closeHour',
          'basePrice', 'nightFromHour', 'nightPrice', 'weekendPrice',
          'cancellationHours', 'maxNoShowsBeforeBlock', 'mpEnabled', 'mpMode',
          'mpDepositPercent', 'subscriptionStatus', 'trialEndsAt', 'monthlyPricePerCourt', 'courtCount',
          'fillEnabled', 'fillMaxGap', 'active', 'createdAt', 'updatedAt'
        ])
        && (!('fillEnabled' in data) || data.fillEnabled is bool)
        && (!('fillMaxGap' in data) || data.fillMaxGap in [1, 2])
        && data.id == clubId && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 16
        && data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 16
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 160
        && (!('neighborhood' in data) || (data.neighborhood is string && data.neighborhood.size() <= 80))
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && isValidId(data.ownerUid)
        && data.slotDurationMinutes is int && data.slotDurationMinutes >= 30 && data.slotDurationMinutes <= 180
        && data.openHour is int && data.openHour >= 0 && data.openHour <= 23
        && data.closeHour is int && data.closeHour >= 1 && data.closeHour <= 24
        && data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 50000
        && data.nightFromHour is int && data.nightFromHour >= 0 && data.nightFromHour <= 23
        && data.nightPrice is number && data.nightPrice >= 0 && data.nightPrice <= 50000
        && data.weekendPrice is number && data.weekendPrice >= 0 && data.weekendPrice <= 50000
        && data.cancellationHours is int && data.cancellationHours >= 0 && data.cancellationHours <= 168
        && data.maxNoShowsBeforeBlock is int && data.maxNoShowsBeforeBlock >= 1 && data.maxNoShowsBeforeBlock <= 20
        && data.mpEnabled is bool
        && data.mpMode is string && data.mpMode in ['full', 'deposit']
        && data.mpDepositPercent is int && data.mpDepositPercent >= 10 && data.mpDepositPercent <= 100
        && data.subscriptionStatus is string && data.subscriptionStatus in ['trial', 'active', 'past_due']
        && (!('trialEndsAt' in data) || (data.trialEndsAt is string && data.trialEndsAt.size() <= 40))
        && data.monthlyPricePerCourt is number && data.monthlyPricePerCourt >= 0 && data.monthlyPricePerCourt <= 50000
        && data.courtCount is int && data.courtCount >= 0 && data.courtCount <= 50
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourt(data, clubId, courtId) {
      return data.keys().hasAll(['id', 'clubId', 'name', 'roof', 'surface', 'hasLights', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'clubId', 'name', 'roof', 'surface', 'hasLights', 'active', 'createdAt', 'updatedAt'])
        && data.id == courtId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.roof is string && data.roof in ['techada', 'aire_libre']
        && data.surface is string && data.surface in ['cristal', 'muro']
        && data.hasLights is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClubMembership(data, clubId, memberUid) {
      return data.keys().hasAll([
          'uid', 'clubId', 'displayName', 'role', 'category', 'gender',
          'preferredModality', 'weeklyAvailability', 'noShowCount', 'blocked',
          'isDiscoverable', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'clubId', 'displayName', 'role', 'category', 'gender',
          'preferredModality', 'weeklyAvailability', 'noShowCount', 'blocked',
          'isDiscoverable', 'createdAt', 'updatedAt'
        ])
        && data.uid == memberUid && isValidId(data.uid)
        && data.clubId == clubId && isValidId(data.clubId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role is string && data.role in ['admin', 'staff', 'player']
        && data.category is int && data.category >= 1 && data.category <= 8
        && data.gender is string && data.gender in ['masculino', 'femenino']
        && data.preferredModality is string && data.preferredModality in ['masculino', 'femenino', 'mixto']
        && data.weeklyAvailability is list && data.weeklyAvailability.size() <= 21
        && data.noShowCount is int && data.noShowCount >= 0 && data.noShowCount <= 100
        && data.blocked is bool
        && data.isDiscoverable is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data, clubId, bookingId) {
      return data.keys().hasAll([
          'id', 'clubId', 'courtId', 'courtName', 'date', 'startMinute', 'endMinute',
          'type', 'status', 'createdByUid', 'playerUids', 'guestName', 'totalPrice',
          'paidAmount', 'paymentMethod', 'paymentStatus', 'holdExpiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clubId', 'courtId', 'courtName', 'date', 'startMinute', 'endMinute',
          'type', 'status', 'createdByUid', 'playerUids', 'guestName', 'totalPrice',
          'paidAmount', 'paymentMethod', 'paymentStatus', 'holdExpiresAt', 'createdAt', 'updatedAt'
        ])
        && data.id == bookingId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && isValidId(data.courtId)
        && data.courtName is string && data.courtName.size() >= 1 && data.courtName.size() <= 60
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startMinute is int && data.startMinute >= 0 && data.startMinute < 1440
        && data.endMinute is int && data.endMinute > data.startMinute && data.endMinute <= 1440
        && data.type is string && data.type in ['direct', 'counter', 'matched', 'tournament']
        && data.status is string && data.status in ['held', 'confirmed', 'cancelled', 'no_show']
        && isValidId(data.createdByUid)
        && data.playerUids is list && data.playerUids.size() <= 4
        && (data.playerUids.size() == 0 || data.playerUids[0] is string)
        && data.guestName is string && data.guestName.size() <= 80
        && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 50000
        && data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 50000
        && data.paymentMethod is string && data.paymentMethod in ['club', 'mercadopago', 'split']
        && data.paymentStatus is string && data.paymentStatus in ['pending', 'deposit_paid', 'paid', 'refunded']
        && data.holdExpiresAt is string && data.holdExpiresAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatchRequest(data, clubId, requestId) {
      return data.keys().hasAll([
          'id', 'clubId', 'clubIds', 'creatorUid', 'creatorName', 'partnerUid',
          'partnerName', 'partnerAccepted', 'category', 'modality', 'requestType',
          'date', 'dayOfWeek', 'startMinute', 'endMinute', 'isSameDay', 'status',
          'unfilledAlertSent', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clubId', 'clubIds', 'creatorUid', 'creatorName', 'partnerUid',
          'partnerName', 'partnerAccepted', 'category', 'modality', 'requestType',
          'date', 'dayOfWeek', 'startMinute', 'endMinute', 'isSameDay', 'status',
          'unfilledAlertSent', 'createdAt', 'updatedAt'
        ])
        && data.id == requestId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && data.clubIds is list && data.clubIds.size() >= 1 && data.clubIds.size() <= 10
        && data.clubIds[0] is string
        && isValidId(data.creatorUid)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80
        && data.partnerUid is string && data.partnerUid.size() <= 128
        && data.partnerName is string && data.partnerName.size() <= 80
        && data.partnerAccepted is bool
        && data.category is int && data.category >= 1 && data.category <= 8
        && data.modality is string && data.modality in ['masculino', 'femenino', 'mixto']
        && data.requestType is string && data.requestType in ['weekly', 'priority']
        && data.date is string && data.date.size() <= 10
        && data.dayOfWeek is int && data.dayOfWeek >= 0 && data.dayOfWeek <= 6
        && data.startMinute is int && data.startMinute >= 0 && data.startMinute < 1440
        && data.endMinute is int && data.endMinute > data.startMinute && data.endMinute <= 1440
        && data.isSameDay is bool
        && data.status is string && data.status in ['waiting', 'proposed', 'confirmed', 'expired', 'cancelled']
        && data.unfilledAlertSent is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProposedMatch(data, clubId, matchId) {
      return data.keys().hasAll([
          'id', 'clubId', 'bookingId', 'courtId', 'courtName', 'date',
          'startMinute', 'endMinute', 'modality', 'minCategory', 'maxCategory',
          'pricePerPlayer', 'playerUids', 'slots', 'expiresAt', 'status',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clubId', 'bookingId', 'courtId', 'courtName', 'date',
          'startMinute', 'endMinute', 'modality', 'minCategory', 'maxCategory',
          'pricePerPlayer', 'playerUids', 'slots', 'expiresAt', 'status',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.id == matchId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && isValidId(data.bookingId)
        && isValidId(data.courtId)
        && data.courtName is string && data.courtName.size() >= 1 && data.courtName.size() <= 60
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startMinute is int && data.startMinute >= 0 && data.startMinute < 1440
        && data.endMinute is int && data.endMinute > data.startMinute && data.endMinute <= 1440
        && data.modality is string && data.modality in ['masculino', 'femenino', 'mixto']
        && data.minCategory is int && data.minCategory >= 1 && data.minCategory <= 8
        && data.maxCategory is int && data.maxCategory >= data.minCategory && data.maxCategory <= 8
        && data.pricePerPlayer is number && data.pricePerPlayer >= 0 && data.pricePerPlayer <= 20000
        && data.playerUids is list && data.playerUids.size() >= 1 && data.playerUids.size() <= 4
        && data.playerUids[0] is string
        && data.slots is list && data.slots.size() == 4
        && data.slots[0] is map
        && data.expiresAt is string && data.expiresAt.size() >= 1 && data.expiresAt.size() <= 40
        && data.status is string && data.status in ['pending', 'confirmed', 'cancelled']
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTournament(data, clubId, tournamentId) {
      return data.keys().hasAll([
          'id', 'clubId', 'name', 'startDate', 'endDate', 'categories', 'maxPairs',
          'entryFee', 'format', 'status', 'pairs', 'matches', 'createdByUid',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clubId', 'name', 'startDate', 'endDate', 'categories', 'maxPairs',
          'entryFee', 'format', 'status', 'pairs', 'matches', 'createdByUid',
          'createdAt', 'updatedAt'
        ])
        && data.id == tournamentId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.startDate is string && data.startDate.size() == 10
        && data.endDate is string && data.endDate.size() == 10
        && data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 8
        && data.categories[0] is int
        && data.maxPairs is int && data.maxPairs >= 4 && data.maxPairs <= 32
        && data.entryFee is number && data.entryFee >= 0 && data.entryFee <= 50000
        && data.format is string && data.format in ['knockout', 'groups_knockout']
        && data.status is string && data.status in ['registration_open', 'draw_generated', 'in_progress', 'completed']
        && data.pairs is list && data.pairs.size() <= 32
        && (data.pairs.size() == 0 || data.pairs[0] is map)
        && data.matches is list && data.matches.size() <= 64
        && (data.matches.size() == 0 || data.matches[0] is map)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRecord(data, clubId, paymentId) {
      return data.keys().hasAll(['id', 'clubId', 'uid', 'clubOwnerUid', 'payerName', 'referenceId', 'amount', 'method', 'kind', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'clubId', 'uid', 'clubOwnerUid', 'payerName', 'referenceId', 'amount', 'method', 'kind', 'status', 'createdAt'])
        && data.id == paymentId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && isValidId(data.uid)
        && isValidId(data.clubOwnerUid)
        && data.payerName is string && data.payerName.size() >= 1 && data.payerName.size() <= 80
        && data.referenceId is string && data.referenceId.size() <= 128
        && data.amount is number && data.amount >= -50000 && data.amount <= 100000
        && data.method is string && data.method in ['mercadopago', 'efectivo', 'transferencia', 'debito_club']
        && data.kind is string && data.kind in ['booking_full', 'booking_deposit', 'match_share', 'tournament_fee', 'refund', 'platform_subscription']
        && data.status is string && data.status in ['completed', 'refunded']
        && data.createdAt is timestamp;
    }

    function isValidNotificationItem(data, clubId, notificationId) {
      return data.keys().hasAll(['id', 'clubId', 'recipientUid', 'eventType', 'title', 'body', 'pushSent', 'emailSent', 'read', 'createdAt'])
        && data.keys().hasOnly(['id', 'clubId', 'recipientUid', 'eventType', 'title', 'body', 'pushSent', 'emailSent', 'read', 'createdAt'])
        && data.id == notificationId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && isValidId(data.recipientUid)
        && data.eventType is string && data.eventType in [
          'booking_confirmed', 'booking_cancelled', 'reminder_2h',
          'match_proposed', 'match_confirmed', 'match_unfilled_1h',
          'tournament_new', 'pair_invite', 'tournament_next_match',
          'waitlist_slot_open'
        ]
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 320
        && data.pushSent is bool
        && data.emailSent is bool
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidPlayerMatchResult(data, uid, resultId) {
      return data.keys().hasAll(['id', 'uid', 'clubId', 'clubName', 'date', 'outcome', 'score', 'modality', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'clubId', 'clubName', 'date', 'outcome', 'score', 'modality', 'createdAt'])
        && data.id == resultId && isValidId(data.id)
        && data.uid == uid && isValidId(data.uid)
        && isValidId(data.clubId)
        && data.clubName is string && data.clubName.size() >= 1 && data.clubName.size() <= 80
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.outcome is string && data.outcome in ['win', 'loss']
        && data.score is string && data.score.size() <= 40
        && data.modality is string && data.modality in ['masculino', 'femenino', 'mixto']
        && data.createdAt is timestamp;
    }

    function isValidUserFriend(data, uid, friendUid) {
      return data.keys().hasAll(['uid', 'ownerUid', 'displayName', 'category', 'gender', 'preferredModality', 'primaryClubId', 'primaryClubName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'ownerUid', 'displayName', 'category', 'gender', 'preferredModality', 'primaryClubId', 'primaryClubName', 'createdAt'])
        && data.uid == friendUid && isValidId(data.uid)
        && data.ownerUid == uid && isValidId(data.ownerUid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.category is int && data.category >= 1 && data.category <= 8
        && data.gender is string && data.gender in ['masculino', 'femenino']
        && data.preferredModality is string && data.preferredModality in ['masculino', 'femenino', 'mixto']
        && data.primaryClubId is string && data.primaryClubId.size() <= 128
        && data.primaryClubName is string && data.primaryClubName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidUserFcmToken(data, uid, tokenId) {
      return data.keys().hasAll(['id', 'uid', 'token', 'deviceLabel', 'platform', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'uid', 'token', 'deviceLabel', 'platform', 'enabled', 'createdAt', 'updatedAt'])
        && data.id == tokenId && isValidId(data.id)
        && data.uid == uid && isValidId(data.uid)
        && data.token is string && data.token.size() >= 10 && data.token.size() <= 512
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 100
        && data.platform is string && data.platform in ['web', 'android', 'ios']
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourtWaitlistEntry(data, clubId, waitlistId) {
      return data.keys().hasAll([
          'id', 'clubId', 'courtId', 'courtName', 'date', 'startMinute',
          'endMinute', 'uid', 'displayName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clubId', 'courtId', 'courtName', 'date', 'startMinute',
          'endMinute', 'uid', 'displayName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id == waitlistId && isValidId(data.id)
        && data.clubId == clubId && isValidId(data.clubId)
        && isValidId(data.courtId)
        && data.courtName is string && data.courtName.size() >= 1 && data.courtName.size() <= 60
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startMinute is int && data.startMinute >= 0 && data.startMinute < 1440
        && data.endMinute is int && data.endMinute > data.startMinute && data.endMinute <= 1440
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.status is string && data.status in ['waiting', 'notified', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isPlatformAdmin());
      allow create, update: if isPlatformAdmin() && isValidId(uid) && isValidAdminMarker(incoming(), uid) && incoming().createdAt == request.time;
      allow delete: if isPlatformAdmin() && isValidId(uid);
    }

    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isPlatformAdmin());
      allow create: if isEmailVerified() && isOwner(uid) && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformAdmin() ||
          (isOwner(uid) && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoUrl', 'category', 'gender', 'preferredModality',
            'weeklyAvailability', 'activeClubIds', 'alertPrefs', 'updatedAt'
          ]))
        );

      match /private/{docId} {
        allow get: if isValidId(uid) && isValidId(docId) && (isOwner(uid) || isPlatformAdmin());
        allow list: if isOwner(uid) || isPlatformAdminEmail();
        allow create, update: if isEmailVerified() && isValidId(uid) && isValidId(docId)
          && (isOwner(uid) || isPlatformAdmin())
          && isValidUserPrivateInfo(incoming(), uid)
          && incoming().updatedAt == request.time;
      }

      match /matchResults/{resultId} {
        allow get: if isSignedIn() && isValidId(uid) && isValidId(resultId) && (isOwner(uid) || isPlatformAdmin());
        allow list: if isSignedIn() && (existing().uid == request.auth.uid || isPlatformAdminEmail());
        allow create: if isEmailVerified() && isValidId(uid) && isValidId(resultId)
          && isOwner(uid)
          && isValidPlayerMatchResult(incoming(), uid, resultId)
          && incoming().createdAt == request.time;
        allow delete: if isEmailVerified() && isValidId(uid) && isValidId(resultId) && (isOwner(uid) || isPlatformAdmin());
      }

      match /friends/{friendUid} {
        allow get: if isSignedIn() && isValidId(uid) && isValidId(friendUid) && (isOwner(uid) || isPlatformAdmin());
        allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isPlatformAdminEmail());
        allow create: if isEmailVerified() && isValidId(uid) && isValidId(friendUid)
          && isOwner(uid)
          && friendUid != uid
          && isValidUserFriend(incoming(), uid, friendUid)
          && incoming().createdAt == request.time;
        allow delete: if isEmailVerified() && isValidId(uid) && isValidId(friendUid)
          && (isOwner(uid) || isPlatformAdmin());
      }

      match /fcmTokens/{tokenId} {
        allow get: if isSignedIn() && isValidId(uid) && isValidId(tokenId) && (isOwner(uid) || isPlatformAdmin());
        allow list: if isSignedIn() && (existing().uid == request.auth.uid || isPlatformAdminEmail());
        allow create: if isEmailVerified() && isValidId(uid) && isValidId(tokenId)
          && isOwner(uid)
          && isValidUserFcmToken(incoming(), uid, tokenId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified() && isValidId(uid) && isValidId(tokenId)
          && isOwner(uid)
          && isValidUserFcmToken(incoming(), uid, tokenId)
          && incoming().id == existing().id
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'token', 'deviceLabel', 'platform', 'enabled', 'updatedAt'
          ]);
        allow delete: if isEmailVerified() && isValidId(uid) && isValidId(tokenId)
          && (isOwner(uid) || isPlatformAdmin());
      }
    }

    match /clubs/{clubId} {
      allow get: if isSignedIn() && isValidId(clubId);
      allow list: if isSignedIn() && (
        existing().active == true ||
        existing().ownerUid == request.auth.uid ||
        isPlatformAdminEmail()
      );
      allow create: if isEmailVerified() && isValidId(clubId)
        && isValidClub(incoming(), clubId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(clubId)
        && isValidClub(incoming(), clubId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isPlatformAdmin() ||
          (isClubAdmin(clubId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'slug', 'primaryColor', 'accentColor', 'address', 'neighborhood', 'city',
            'lat', 'lng', 'slotDurationMinutes', 'openHour', 'closeHour', 'basePrice',
            'nightFromHour', 'nightPrice', 'weekendPrice', 'cancellationHours',
            'maxNoShowsBeforeBlock', 'mpEnabled', 'mpMode', 'mpDepositPercent',
            'courtCount', 'fillEnabled', 'fillMaxGap', 'updatedAt'
          ]))
        );

      match /courts/{courtId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(courtId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(courtId)
          && clubExists(clubId)
          && isClubAdmin(clubId)
          && isValidCourt(incoming(), clubId, courtId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(courtId)
          && isClubAdmin(clubId)
          && isValidCourt(incoming(), clubId, courtId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'roof', 'surface', 'hasLights', 'active', 'updatedAt'
          ]);
        allow delete: if isEmailVerified() && isValidId(clubId) && isValidId(courtId) && isClubAdmin(clubId);
      }

      match /memberships/{memberUid} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(memberUid);
        allow list: if isSignedIn() && existing().clubId == clubId && (
          existing().isDiscoverable == true ||
          existing().uid == request.auth.uid ||
          isPlatformAdminEmail()
        );
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(memberUid)
          && clubExists(clubId)
          && isValidClubMembership(incoming(), clubId, memberUid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubOwner(clubId) ||
            (isOwner(memberUid) && incoming().role == 'player' && incoming().noShowCount == 0 && incoming().blocked == false)
          );
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(memberUid)
          && isValidClubMembership(incoming(), clubId, memberUid)
          && incoming().uid == existing().uid
          && incoming().clubId == existing().clubId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            (isClubStaffOrAdmin(clubId) && incoming().diff(existing()).affectedKeys().hasOnly(['noShowCount', 'blocked', 'updatedAt'])) ||
            (isOwner(memberUid) && incoming().role == existing().role && incoming().noShowCount == existing().noShowCount && incoming().blocked == existing().blocked
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'category', 'gender', 'preferredModality', 'weeklyAvailability', 'isDiscoverable', 'updatedAt'
              ]))
          );
      }

      match /bookings/{bookingId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(bookingId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(bookingId)
          && clubExists(clubId)
          && isValidBooking(incoming(), clubId, bookingId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isClubStaffOrAdmin(clubId) ||
            (isClubMember(clubId) && incoming().createdByUid == request.auth.uid && incoming().type in ['direct', 'matched', 'tournament'])
          );
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(bookingId)
          && isValidBooking(incoming(), clubId, bookingId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            (existing().status in ['held', 'confirmed'] && isClubStaffOrAdmin(clubId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'paidAmount', 'paymentMethod', 'paymentStatus', 'holdExpiresAt', 'playerUids', 'updatedAt'
            ])) ||
            (existing().status in ['held', 'confirmed'] && isClubMember(clubId) && (
              existing().createdByUid == request.auth.uid || request.auth.uid in existing().playerUids
            ) && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'paidAmount', 'paymentMethod', 'paymentStatus', 'holdExpiresAt', 'playerUids', 'updatedAt'
            ]))
          );
      }

      match /matchRequests/{requestId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(requestId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(requestId)
          && clubExists(clubId)
          && isValidMatchRequest(incoming(), clubId, requestId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isClubAdmin(clubId) ||
            (isClubMember(clubId) && incoming().creatorUid == request.auth.uid)
          );
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(requestId)
          && isValidMatchRequest(incoming(), clubId, requestId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().creatorUid == existing().creatorUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            (existing().status in ['waiting', 'proposed'] && isClubMember(clubId) && (
              existing().creatorUid == request.auth.uid || existing().partnerUid == request.auth.uid ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'unfilledAlertSent', 'updatedAt'])
            ) && incoming().diff(existing()).affectedKeys().hasOnly([
              'partnerAccepted', 'status', 'unfilledAlertSent', 'startMinute', 'endMinute', 'updatedAt'
            ]))
          );
      }

      match /proposedMatches/{matchId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(matchId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(matchId)
          && clubExists(clubId)
          && isClubMember(clubId)
          && isValidProposedMatch(incoming(), clubId, matchId)
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(matchId)
          && isValidProposedMatch(incoming(), clubId, matchId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().bookingId == existing().bookingId
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            // El encargado del mostrador solo puede marcar quién pagó su parte.
            (isClubStaffOrAdmin(clubId) && incoming().diff(existing()).affectedKeys().hasOnly(['slots', 'updatedAt'])) ||
            (existing().status == 'pending' && isClubMember(clubId) && (
              request.auth.uid in existing().playerUids || existing().createdByUid == request.auth.uid
            ) && incoming().diff(existing()).affectedKeys().hasOnly([
              'slots', 'playerUids', 'status', 'expiresAt', 'updatedAt'
            ]))
          );
      }

      match /tournaments/{tournamentId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(tournamentId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(tournamentId)
          && clubExists(clubId)
          && isClubAdmin(clubId)
          && isValidTournament(incoming(), clubId, tournamentId)
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(tournamentId)
          && isValidTournament(incoming(), clubId, tournamentId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            (existing().status in ['draw_generated', 'in_progress'] && isClubStaffOrAdmin(clubId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'matches', 'status', 'updatedAt'
            ])) ||
            (existing().status == 'registration_open' && isClubMember(clubId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'pairs', 'updatedAt'
            ]))
          );
      }

      match /payments/{paymentId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(paymentId) && (
          existing().uid == request.auth.uid ||
          existing().clubOwnerUid == request.auth.uid ||
          isClubStaffOrAdmin(clubId) ||
          isPlatformAdmin()
        );
        allow list: if isSignedIn() && existing().clubId == clubId && (
          existing().uid == request.auth.uid ||
          existing().clubOwnerUid == request.auth.uid ||
          isPlatformAdminEmail()
        );
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(paymentId)
          && clubExists(clubId)
          && isValidPaymentRecord(incoming(), clubId, paymentId)
          && incoming().createdAt == request.time
          && (
            isClubStaffOrAdmin(clubId) ||
            (isClubMember(clubId) && incoming().uid == request.auth.uid)
          );
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(paymentId)
          && isValidPaymentRecord(incoming(), clubId, paymentId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().uid == existing().uid
          && incoming().clubOwnerUid == existing().clubOwnerUid
          && incoming().createdAt == existing().createdAt
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            (existing().status == 'completed' && (isOwner(existing().uid) || isClubStaffOrAdmin(clubId)) && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
          );
      }

      match /notifications/{notificationId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(notificationId) && (
          existing().recipientUid == request.auth.uid ||
          isClubStaffOrAdmin(clubId) ||
          isPlatformAdmin()
        );
        allow list: if isSignedIn() && existing().clubId == clubId && (
          existing().recipientUid == request.auth.uid ||
          isPlatformAdminEmail()
        );
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(notificationId)
          && clubExists(clubId)
          && isClubMember(clubId)
          && isValidNotificationItem(incoming(), clubId, notificationId)
          && incoming().createdAt == request.time;
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(notificationId)
          && isValidNotificationItem(incoming(), clubId, notificationId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().recipientUid == existing().recipientUid
          && incoming().createdAt == existing().createdAt
          && (
            isPlatformAdmin() ||
            (isOwner(existing().recipientUid) && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
          );
      }

      match /matchResults/{resultId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(resultId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(resultId)
          && clubExists(clubId)
          && incoming().clubId == clubId
          && incoming().uid == request.auth.uid
          && isValidPlayerMatchResult(incoming(), request.auth.uid, resultId)
          && incoming().createdAt == request.time;
        allow delete: if isEmailVerified() && isValidId(clubId) && isValidId(resultId)
          && (existing().uid == request.auth.uid || isClubAdmin(clubId) || isPlatformAdmin());
      }

      // "Falta uno": solo las escribe el servidor (Cloud Functions). El celular solo lee.
      match /fillSearches/{searchId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(searchId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow write: if false;
      }

      match /fillInvites/{inviteId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(inviteId)
          && (existing().uid == request.auth.uid || isClubStaffOrAdmin(clubId) || isPlatformAdmin());
        allow list: if isSignedIn() && existing().clubId == clubId
          && (existing().uid == request.auth.uid || isClubStaffOrAdmin(clubId) || isPlatformAdmin());
        allow write: if false;
      }

      match /recoveries/{recoveryId} {
        allow get, list: if isSignedIn() && isValidId(clubId) && (isClubStaffOrAdmin(clubId) || isPlatformAdmin());
        allow write: if false;
      }

      match /waitlist/{waitlistId} {
        allow get: if isSignedIn() && isValidId(clubId) && isValidId(waitlistId);
        allow list: if isSignedIn() && existing().clubId == clubId;
        allow create: if isEmailVerified() && isValidId(clubId) && isValidId(waitlistId)
          && clubExists(clubId)
          && isClubMember(clubId)
          && isValidCourtWaitlistEntry(incoming(), clubId, waitlistId)
          && incoming().uid == request.auth.uid
          && incoming().status == 'waiting'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified() && isValidId(clubId) && isValidId(waitlistId)
          && isValidCourtWaitlistEntry(incoming(), clubId, waitlistId)
          && incoming().id == existing().id
          && incoming().clubId == existing().clubId
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isPlatformAdmin() ||
            isClubAdmin(clubId) ||
            (isOwner(existing().uid) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            (isClubMember(clubId) && existing().status == 'waiting' && incoming().status == 'notified'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          );
        allow delete: if isEmailVerified() && isValidId(clubId) && isValidId(waitlistId)
          && (isOwner(existing().uid) || isClubAdmin(clubId) || isPlatformAdmin());
      }
    }
  }
}
