rules_version = '2';
// Fotos de perfil: cualquiera con sesión las ve; cada jugador sube solo la suya,
// ya achicada en el celular (webp, menos de 300 KB).
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && file == request.auth.uid + '.webp'
        && request.resource.size < 300 * 1024
        && request.resource.contentType == 'image/webp';
    }
    // Logo y fotos de la marca del club (Admin → Apariencia, 17/11/2026). Las ve cualquiera
    // (salen en la app del club y en la entrada). Las sube solo el servidor (callable marcaSubirImagen),
    // que revisa que quien sube sea dueño o administrador del club y que sea PNG o WebP de menos de 1 MB.
    match /clubs/{clubId}/marca/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
