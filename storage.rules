rules_version = '2';
// Fotos de perfil: cualquiera con sesión las ve; cada jugador sube solo la suya,
// ya achicada en el celular (webp, menos de 300 KB).
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && file == request.auth.uid + '.webp'
        && request.resource.size < 300 * 1024
        && request.resource.contentType == 'image/webp';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
